# .env para Dokploy - Flask API + PostgreSQL + MinIO
# ============================================================
# Esta configuración está optimizada para Dokploy/Docker
# ============================================================

# === ENTORNO FLASK ===
FLASK_ENV=production
FLASK_DEBUG=0

# === BASE DE DATOS POSTGRESQL ===
# Dokploy inyecta automáticamente esta variable o usa la siguiente:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/electoral_db

# === SEGURIDAJA ===
# Cambiar inmediatamente en producción!
SECRET_KEY=dia-d-production-secret-key-unique-change-immediately

# === JWT ===
JWT_SECRET_KEY=dia-d-jwt-secret-key-must-be-32-chars

# === S3 / MINIO (Almacenamiento de evidencias) ===
# Dokploy services: minio estará en red interna como 'minio'
S3_ENABLED=True
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=electoral-evidencias
S3_USE_SSL=False

# === CHROMA (Vector DB - desactivado por ahora) ===
CHROMA_ENABLED=False
CHROMA_PERSIST_DIR=/data/chroma

# === CONFIGURACIÓN INTERNA ===
DB_HOST=postgres
DB_PORT=5432

# === PUERTO ===
PORT=5000