# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database
DATABASE_URL=sqlite:///instance/electoral.db
# Para PostgreSQL en producción:
# DATABASE_URL=postgresql://user:password@localhost:5432/electoral

# Upload Configuration (default local; set S3_ENABLED=True to use MinIO/S3)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
ALLOWED_EXTENSIONS=png,jpg,jpeg,pdf
# S3 / MinIO (opcional)
S3_ENABLED=False
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=electoral-evidencias
S3_USE_SSL=False
# Chroma (opcional)
CHROMA_ENABLED=False
CHROMA_PERSIST_DIR=chroma_db
CHROMA_SERVER_HOST=
CHROMA_SERVER_PORT=8000

# Logging
LOG_LEVEL=INFO

# Emergency Endpoints (SOLO PARA DESARROLLO/EMERGENCIAS)
# Descomentar y configurar solo si necesitas usar endpoints de emergencia
# EMERGENCY_RESET_KEY=tu-clave-secreta-muy-segura-aqui
# ALLOW_EMERGENCY_ENDPOINTS=false  # Cambiar a true solo en emergencias en producción
